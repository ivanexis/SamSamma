flowchart TD
    Entry(["進站"])
    Home["#home"]
    Pillars["#pillars-bar"]

    SharedAbout["#about<br/>共用·品牌敘事"]
    SharedWhy["#why-us<br/>共用·量化報告"]

    Split{{"#plans 四卡<br/>結構分流點"}}

    P1["culture 卡"]
    P2["corporate 卡"]
    P3["commerce 卡"]
    P4["art 卡"]

    R1["/booking/?plan=culture<br/>React 子應用"]
    R2["/booking/?plan=corporate<br/>React 子應用"]
    M1["mailto 採購"]
    M2["mailto 洽談"]

    Direct["#booking<br/>Hero/Nav 直跳"]
    Form["#bookingForm 11 欄<br/>index 站內表單"]
    FAQ["booking-faq 6 題<br/>DOM 在表單下方"]
    Submit["fetch POST"]
    Success["站內成功面板"]
    Fail["mailto fallback"]

    Entry --> Home --> Pillars
    Pillars --> SharedAbout
    SharedAbout --> SharedWhy
    SharedWhy --> Split
    Home -.急件.-> Direct
    Pillars -.跳過.-> Split

    Split --> P1 --> R1
    Split --> P2 --> R2
    Split --> P3 --> M1
    Split --> P4 --> M2

    R1 --> Submit
    R2 --> Submit
    Direct --> Form
    Form --> Submit
    Form --> FAQ
    Submit --> Success
    Submit -.fail.-> Fail

    classDef shared fill:#f5f0e8,stroke:#8b7355,color:#3d2b1f
    classDef common fill:#e8eaf6,stroke:#3949ab,color:#1a237e
    classDef school fill:#d4edda,stroke:#28a745,color:#155724
    classDef enterprise fill:#cce5ff,stroke:#004085,color:#004085
    classDef mail fill:#ffe0b2,stroke:#ef6c00,color:#7a3e00
    classDef split fill:#fff3cd,stroke:#d9960a,color:#7a4f00
    classDef backend fill:#c8e6c9,stroke:#388e3c,color:#1b5e20
    classDef fail fill:#ffcdd2,stroke:#c62828,color:#b71c1c

    class Entry,Home,Pillars,Direct,Form,FAQ shared
    class SharedAbout,SharedWhy common
    class P1,R1 school
    class P2,R2 enterprise
    class P3,P4,M1,M2 mail
    class Split split
    class Submit,Success backend
    class Fail fail
